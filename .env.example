# Nalam Care Medicals — environment
# Copy to .env.local and fill in. Never commit real values.

# Database (Neon Postgres connection string)
DATABASE_URL=

# Authentication — one login page, two roles (admin / staff).
# ADMIN_PASSCODE always signs in as admin, so the owner can't be locked out.
# Individual staff and admin accounts, with Retail / Wholesale / both access,
# are created by an admin in Settings → Users & Access.
ADMIN_PASSCODE=admin123
# Optional shared staff passcode kept for existing installs; leave blank to
# use only the accounts from Settings. STAFF_MODES sets its dashboards.
STAFF_PASSCODE=staff123
STAFF_MODES=retail,wholesale

# Signs the session cookie. Use a long random value.
SESSION_SECRET=
